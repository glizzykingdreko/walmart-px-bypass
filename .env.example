# Copy to .env and fill in. .env is gitignored — never commit real values.

# Required by every example. Get yours from Takion.
TAKION_API_KEY=

# Required by us_web_signin and us_mobile_signin.
WALMART_EMAIL=

# Required by us_mobile_signin (it performs a real password login).
WALMART_PASSWORD=

# Optional. ca_web_account_create stops at phone verification without it.
# Paste the SMS code here to complete a real registration.
WALMART_SIGNUP_OTP=
